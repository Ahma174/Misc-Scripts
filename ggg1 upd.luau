local joints = {}
for _, d in ipairs(model2:GetDescendants()) do
	if d:IsA("Motor6D") then
		if d.Part1 then
			joints[d.Part1.Name] = d
		end
		joints[d.Name] = joints[d.Name] or d
	end
end

local tracks = {}
local lengths = {}
for animName, keyframes in pairs(animations) do
	local poseTracks = {}
	local length = 0
	for _, kf in ipairs(keyframes) do
		length = math.max(length, kf.Time)
		for poseName, cf in pairs(kf.Poses) do
			poseTracks[poseName] = poseTracks[poseName] or {}
			table.insert(poseTracks[poseName], {Time = kf.Time, CFrame = cf})
		end
	end
	for _, list in pairs(poseTracks) do
		table.sort(list, function(a, b)
			return a.Time < b.Time
		end)
	end
	tracks[animName] = poseTracks
	lengths[animName] = length
end

local function sample(list, time)
	if time <= list[1].Time then
		return list[1].CFrame
	end
	for i = 2, #list do
		local a = list[i - 1]
		local b = list[i]
		if time <= b.Time then
			local span = b.Time - a.Time
			if span <= 0 then
				return b.CFrame
			end
			return a.CFrame:Lerp(b.CFrame, (time - a.Time) / span)
		end
	end
	return list[#list].CFrame
end

local currentAnim = ""
local animTime = 0
local blendTime = 0
local blendDuration = 0.2
local snapshot = {}

local function play(name)
	if name == currentAnim or not tracks[name] then
		return
	end
	for poseName, motor in pairs(joints) do
		snapshot[poseName] = motor.Transform
	end
	currentAnim = name
	animTime = 0
	blendTime = 0
end

local function updateAnimation(dt)
	local length = lengths[currentAnim]
	if length <= 0 then
		return
	end
	animTime = (animTime + dt) % length
	blendTime = math.min(blendTime + dt, blendDuration)
	local alpha = blendTime / blendDuration

	for poseName, list in pairs(tracks[currentAnim]) do
		local motor = joints[poseName]
		if motor then
			local target = sample(list, animTime)
			local previous = snapshot[poseName]
			if previous and alpha < 1 then
				motor.Transform = previous:Lerp(target, alpha)
			else
				motor.Transform = target
			end
		end
	end
end

local bodyPos = Instance.new("BodyPosition")
bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
bodyPos.P = 20000
bodyPos.Position = rootPart.Position
bodyPos.Parent = base

local bodyGyro = Instance.new("BodyGyro")
bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
bodyGyro.CFrame = rootPart.CFrame
bodyGyro.Parent = base

local petOffset = CFrame.new(5, 0, -3)

local bobMax = 0
local bobT = 0
local bobSpeed = 0
local bobUp = false
local tiltAngle = 5

RunService.RenderStepped:Connect(function(dt)
	if not bobUp then
		bobT += bobSpeed
		if bobT >= bobMax then
			bobUp = true
		end
		if tiltAngle < 5 then
			tiltAngle += 0.1
		end
	else
		bobT -= bobSpeed
		if bobT <= 0 then
			bobUp = false
		end
		if tiltAngle > -5 then
			tiltAngle -= 0.1
		end
	end

	bodyPos.Position = (
		rootPart.CFrame * CFrame.new(petOffset.X, petOffset.Y + bobT, petOffset.Z)
	).Position

	if humanoid.MoveDirection == Vector3.new(0, 0, 0) then
		bodyGyro.CFrame = CFrame.new(
			base.Position,
			Vector3.new(rootPart.Position.X, base.Position.Y, rootPart.Position.Z)
		)
		bobMax = 0
		bobSpeed = 0
		play("Idle")
	else
		bodyGyro.CFrame = rootPart.CFrame
		bobMax = 0
		bobSpeed = 0
		play("Walk")
	end

	updateAnimation(dt)
end)


