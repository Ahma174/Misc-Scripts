bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
bodyPos.P = 20000
bodyPos.D = 1000
bodyPos.Parent = base

local bodyGyro = Instance.new("BodyGyro")
bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
bodyGyro.P = 20000
bodyGyro.D = 1000
bodyGyro.Parent = base

local flyingOffset = CFrame.new(5, -0.6, 3)

RunService.RenderStepped:Connect(function()
	local targetCFrame = rootPart.CFrame * flyingOffset
	bodyPos.Position = targetCFrame.Position

	local velocity = rootPart.AssemblyLinearVelocity
	local flatVelocity = Vector3.new(
		velocity.X,
		0,
		velocity.Z
	)

	if flatVelocity.Magnitude > 1 then
		bodyGyro.CFrame = CFrame.lookAt(
			base.Position,
			base.Position + flatVelocity.Unit
		)
	else
		bodyGyro.CFrame = CFrame.lookAt(
			base.Position,
			Vector3.new(
				rootPart.Position.X,
				base.Position.Y,
				rootPart.Position.Z
			)
		)
	end
end)

