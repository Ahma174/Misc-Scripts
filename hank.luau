-- Anim Player by ChatGPT because bro decided to adapt to it

local animation = {}

for keyframeIndex, keyframeData in ipairs(D) do
    local poses = {}
    local dataIndex = 2

    for poseIndex, poseName in ipairs(N) do
        local x = keyframeData[dataIndex]
        local y = keyframeData[dataIndex + 1]
        local z = keyframeData[dataIndex + 2]

        dataIndex += 3

        local position = Vector3.zero

        if P[poseIndex] then
            position = Vector3.new(
                keyframeData[dataIndex],
                keyframeData[dataIndex + 1],
                keyframeData[dataIndex + 2]
            )

            dataIndex += 3
        end

        local w = math.sqrt(
            math.max(0, 1 - x * x - y * y - z * z)
        )

        poses[poseName] = {
            CFrame = CFrame.new(
                position.X,
                position.Y,
                position.Z,
                x, y, z, w
            ),
            Weight = W[poseIndex]
        }
    end

    animation[keyframeIndex] = {
        Time = keyframeData[1],
        Poses = poses
    }
end

local motors = {}

for _, obj in ipairs(model2:GetDescendants()) do
    if obj:IsA("Motor6D") and obj.Part1 then
        motors[obj.Part1.Name] = obj
    end
end

local animationLength = animation[#animation].Time

local function playAnimation()
    local startTime = os.clock()

    while model2.Parent do
        local elapsed = (os.clock() - startTime) % animationLength

        local currentFrame = animation[1]
        local nextFrame = animation[#animation]

        for i = 1, #animation do
            if animation[i].Time >= elapsed then
                currentFrame = animation[i]
                nextFrame = animation[math.max(1, i - 1)]
                break
            end
        end

        local alpha = 0

        if currentFrame ~= nextFrame then
            local time1 = nextFrame.Time
            local time2 = currentFrame.Time

            if time2 > time1 then
                alpha = math.clamp(
                    (elapsed - time1) / (time2 - time1),
                    0,
                    1
                )
            end
        end

        for poseName, pose in pairs(currentFrame.Poses) do
            local motor = motors[poseName]

            if motor then
                local previousPose = nextFrame.Poses[poseName]

                if previousPose then
                    motor.Transform = previousPose.CFrame:Lerp(
                        pose.CFrame,
                        alpha
                    )
                else
                    motor.Transform = pose.CFrame
                end
            end
        end

        RunService.RenderStepped:Wait()
    end
end

task.spawn(playAnimation)

local bodyPos = Instance.new("BodyPosition")
bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
bodyPos.P = 20000
bodyPos.Position = rootPart.Position
bodyPos.Parent = base

local bodyGyro = Instance.new("BodyGyro")
bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
bodyGyro.CFrame = rootPart.CFrame
bodyGyro.Parent = base

local flyingOffset = CFrame.new(5, 2, -3)
local bobUp = false
local bobT = 0
local bobSpeed = 0.01
local bobMax = 1
local tiltAngle = 5

RunService.RenderStepped:Connect(function()
	if not bobUp then
		bobT = bobT + bobSpeed
		if bobT >= bobMax then bobUp = true end
		if tiltAngle < 5 then tiltAngle = tiltAngle + 0.1 end
	else
		bobT = bobT - bobSpeed
		if bobT <= 0 then bobUp = false end
		if tiltAngle > -5 then tiltAngle = tiltAngle - 0.1 end
	end
	local targetPos = (rootPart.CFrame * flyingOffset).p
	bodyPos.Position = Vector3.new(targetPos.X, targetPos.Y + bobT, targetPos.Z)
	if humanoid.MoveDirection == Vector3.new(0, 0, 0) then
		bodyGyro.CFrame = CFrame.new(base.Position, Vector3.new(rootPart.Position.X, base.Position.Y, rootPart.Position.Z)) * CFrame.Angles(math.rad(tiltAngle), 0, 0)
	else
		bodyGyro.CFrame = rootPart.CFrame * CFrame.Angles(math.rad(tiltAngle), 0, 0)
	end
end)
