local animation = {}

for keyframeIndex, keyframeData in ipairs(D) do
	local poses = {}
	local dataIndex = 2

	for poseIndex, poseName in ipairs(N) do
		local x = keyframeData[dataIndex]
		local y = keyframeData[dataIndex + 1]
		local z = keyframeData[dataIndex + 2]
		dataIndex += 3

		local px, py, pz = 0, 0, 0
		if P[poseIndex] then
			px = keyframeData[dataIndex]
			py = keyframeData[dataIndex + 1]
			pz = keyframeData[dataIndex + 2]
			dataIndex += 3
		end

		local w = math.sqrt(math.max(0, 1 - x * x - y * y - z * z))
		poses[poseName] = CFrame.new(px, py, pz, x, y, z, w)
	end

	animation[keyframeIndex] = { Time = keyframeData[1], Poses = poses }
end

local motors = {}
for _, obj in ipairs(rig:GetDescendants()) do
	if obj:IsA("Bone") or obj:IsA("Motor6D") then
		motors[obj.Name] = obj
	end
end

local length = animation[#animation].Time
local playing = true
local startTime = os.clock()

local function sample(t)
	local lo, hi = animation[1], animation[#animation]
	for i = 2, #animation do
		if animation[i].Time >= t then
			lo, hi = animation[i - 1], animation[i]
			break
		end
	end
	local span = hi.Time - lo.Time
	local alpha = span > 0 and math.clamp((t - lo.Time) / span, 0, 1) or 0
	for name, cf in pairs(lo.Poses) do
		local motor = motors[name]
		if motor then
			motor.Transform = cf:Lerp(hi.Poses[name] or cf, alpha)
		end
	end
end

local conn
conn = RunService.RenderStepped:Connect(function()
	if not playing or not rig.Parent then
		conn:Disconnect()
		return
	end
	local elapsed = (os.clock() - startTime) * speed
	if elapsed > length and not loop then
		playing = false
		return
	end
	sample(elapsed % length)
end)

local bodyPos = Instance.new("BodyPosition")
bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
bodyPos.P = 20000
bodyPos.Position = rootPart.Position
bodyPos.Parent = base

local bodyGyro = Instance.new("BodyGyro")
bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
bodyGyro.CFrame = rootPart.CFrame
bodyGyro.Parent = base

local flyingOffset = CFrame.new(5, 2, -3)
local bobUp = false
local bobT = 0
local bobSpeed = 0.01
local bobMax = 1
local tiltAngle = 5

RunService.RenderStepped:Connect(function()
	if not bobUp then
		bobT = bobT + bobSpeed
		if bobT >= bobMax then bobUp = true end
		if tiltAngle < 5 then tiltAngle = tiltAngle + 0.1 end
	else
		bobT = bobT - bobSpeed
		if bobT <= 0 then bobUp = false end
		if tiltAngle > -5 then tiltAngle = tiltAngle - 0.1 end
	end
	local targetPos = (rootPart.CFrame * flyingOffset).p
	bodyPos.Position = Vector3.new(targetPos.X, targetPos.Y + bobT, targetPos.Z)
	if humanoid.MoveDirection == Vector3.new(0, 0, 0) then
		bodyGyro.CFrame = CFrame.new(base.Position, Vector3.new(rootPart.Position.X, base.Position.Y, rootPart.Position.Z)) * CFrame.Angles(math.rad(tiltAngle), 0, 0)
	else
		bodyGyro.CFrame = rootPart.CFrame * CFrame.Angles(math.rad(tiltAngle), 0, 0)
	end
end)